# Next.js: use the stored snapshot provider when the local data API is running.
FPL_DATA_API_URL=http://127.0.0.1:8000

# FastAPI: SQLite is the exercised local fallback. Production targets PostgreSQL.
DATABASE_URL=sqlite:///./data/fpl.db
FPL_SEASON=2026/27

# Private preview: when set, every page and API route is behind one shared
# passphrase. Leave it unset to run the site open, as local development does.
# Cloudflare reads it from .dev.vars locally and `wrangler secret put` in
# production; Vercel reads it from the project's environment variables.
SITE_PASSPHRASE=
